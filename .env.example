API_URL=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_ORGANIZATION_NAME=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_FEATURE_AI_ASSISTANT_ENABLED=false
NEXT_PUBLIC_AGORA_APP_ID=
# Optional override for WebSocket URL (defaults to same-origin /api/v1/communication/ws)
NEXT_PUBLIC_REALTIME_WS_URL=
AUTH_ACCESS_COOKIE=pb_access
AUTH_REFRESH_COOKIE=pb_refresh
AUTH_REMEMBER_COOKIE=pb_remember
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_REFRESH_MAX_AGE_SECONDS=2592000
# Comma-separated hostnames allowed in Content-Security-Policy img-src (and next/image
# remotePatterns) for tenant logos. Include the scheme for http MinIO (e.g. http://127.0.0.1:9000).
# Example: http://127.0.0.1:9000,*.s3.amazonaws.com,d111111abcdef8.cloudfront.net
LOGO_IMAGE_HOSTS=
